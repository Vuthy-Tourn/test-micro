# ─────────────────────────────────────────────────────────────────────────────
# .env.example – copy to .env on the GCP VM and fill in real values
# Location on VM: ~/notification-service/.env
# ─────────────────────────────────────────────────────────────────────────────

# Docker Hub (set by CI automatically, but needed for first manual deploy)
DOCKER_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# SMTP (Gmail or any provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=1249457390

# Kafka bootstrap servers (internal Docker hostnames or GCP IPs)
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:9090,kafka-broker-2:9090,kafka-broker-3:9090

# Eureka service discovery
EUREKA_SERVER_URL=http://eureka-server:8761/eureka
